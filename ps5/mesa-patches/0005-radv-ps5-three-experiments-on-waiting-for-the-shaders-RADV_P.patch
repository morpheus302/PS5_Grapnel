+/* RADV_PS5_SYNC_CS=1 and RADV_PS5_SYNC_PS=1, experiments: the halves of
+ * RADV_DEBUG=syncshaders, the wait for the compute engine after each dispatch
+ * and the wait for the graphics one after each draw, each on its own. */
+static unsigned
+radv_ps5_sync_flags(void)
+{
+   static int flags = -1;
+   if (flags < 0) {
+      const char *const cs = getenv("RADV_PS5_SYNC_CS");
+      const char *const ps = getenv("RADV_PS5_SYNC_PS");
+      flags = (cs && atoi(cs) != 0 ? RADV_CMD_FLAG_CS_PARTIAL_FLUSH : 0) |
+              (ps && atoi(ps) != 0 ? RADV_CMD_FLAG_PS_PARTIAL_FLUSH : 0);
+   }
+   return (unsigned)flags;
+}
