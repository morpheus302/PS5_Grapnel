+/* RADV_PS5_SUBMIT_IDLE=1, an experiment: each AGC submission ends by waiting
+ * for the graphics and compute shaders it started (PS_PARTIAL_FLUSH and
+ * CS_PARTIAL_FLUSH), before its completion and so before the next submission,
+ * which starts from reset GPU state. A title stopped the GPU in the first
+ * submission after one that held its compute passes, ten times sooner with one
+ * command buffer a submission, and not at all with RADV_DEBUG=syncshaders.
+ * Unset or 0: as ever. */
+#define RADV_PS5_IDLE_WORDS 4
+
+static bool
+radv_ps5_submit_idle(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *const setting = getenv("RADV_PS5_SUBMIT_IDLE");
+      on = setting && atoi(setting) != 0;
+   }
+   return on != 0;
+}
+
+static uint32_t *
+radv_ps5_idle_words(uint32_t *words)
+{
+   words[0] = PKT3(PKT3_EVENT_WRITE, 0, 0);
+   words[1] = EVENT_TYPE(V_028A90_PS_PARTIAL_FLUSH) | EVENT_INDEX(4);
+   words[2] = PKT3(PKT3_EVENT_WRITE, 0, 0);
+   words[3] = EVENT_TYPE(V_028A90_CS_PARTIAL_FLUSH) | EVENT_INDEX(4);
+   return words + RADV_PS5_IDLE_WORDS;
+}
+
 static void
 radv_ps5_completion_words(uint32_t *words, uint64_t marker_address, uint32_t value)
 {
