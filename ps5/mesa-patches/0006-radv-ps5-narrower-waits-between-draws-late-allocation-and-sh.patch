diff --git a/src/amd/vulkan/radv_ps5_waits.h b/src/amd/vulkan/radv_ps5_waits.h
new file mode 100644
index 0000000000000000000000000000000000000000..9fb520a9d19f2282399578d1abea757719a8bd3a
--- /dev/null
+++ b/src/amd/vulkan/radv_ps5_waits.h
@@ -0,0 +1,64 @@
+/*
+ * Copyright © 2026 hookshot-ps5
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/* The PS5 port's switches on how the GPU waits between draws, and what they did (lot 57 of the Hookshot port).
+ *
+ * RADV_DEBUG=syncshaders (or RADV_PS5_SYNC_PS=1 with RADV_PS5_SYNC_CS=1) kept a title's GPU hangs away on the console,
+ * at the price of every draw running alone on the GPU. These switches narrow the wait, or try to take away what it may
+ * hide, one at a time; all unset, the driver does as before:
+ *
+ * - RADV_PS5_SYNC_PS: unset or 0 no wait after a draw; 1 or each after every draw (syncshaders' half); program only
+ *   before a draw whose shaders are not the last draw's (and before a command buffer's first draw and a dispatch) when a
+ *   draw ran since the last wait; vertex: VS_PARTIAL_FLUSH after every draw (the vertex and primitive waves only).
+ * - RADV_PS5_LATE_ALLOC: unset as GFX10.3 (late allocation of the parameter cache for NGG waves, CU1 left out of their
+ *   CU mask); gfx10 as GFX10 (GC 10.1.x) asks: the late allocation held to 64 waves and CU2 and CU3 left out; off: no late
+ *   allocation, every CU.
+ * - RADV_PS5_NGGC: unset as ever; 0 the shader-based NGG culling turned off at draw time (its settings register 0), the
+ *   shaders unchanged: the hardware's own culling stays.
+ *
+ * None of these change a compiled shader or the shader cache's key (radv_device_init_cache_key). */
+
+#ifndef RADV_PS5_WAITS_H
+#define RADV_PS5_WAITS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* radv_ps5_waits_stats' slots, counts since the start */
+enum radv_ps5_waits_stat {
+   RADV_PS5_WAITS_DRAWS,            /* draws recorded (the title's and the driver's own) */
+   RADV_PS5_WAITS_EACH,       /* waits for the pixel shaders after a draw (syncshaders or RADV_PS5_SYNC_PS=1) */
+   RADV_PS5_WAITS_PROGRAM,    /* RADV_PS5_SYNC_PS=program: waits before a draw of other shaders */
+   RADV_PS5_WAITS_FIRST,      /* RADV_PS5_SYNC_PS=program: waits before a command buffer's first draw */
+   RADV_PS5_WAITS_DISPATCH,   /* RADV_PS5_SYNC_PS=program: waits before a dispatch that follows draws */
+   RADV_PS5_WAITS_VERTEX,     /* RADV_PS5_SYNC_PS=vertex: waits for the vertex waves after a draw */
+   RADV_PS5_WAITS_COMPUTE,    /* waits for the compute shaders after a dispatch (syncshaders or RADV_PS5_SYNC_CS=1) */
+   RADV_PS5_WAITS_DISPATCHES,       /* dispatches recorded */
+   RADV_PS5_WAITS_STAT_COUNT
+};
+
+/* Copies the counts since the start into out[RADV_PS5_WAITS_STAT_COUNT]; the count of slots it fills (newer drivers may
+ * have more). A command buffer's counts are added when it ends. */
+unsigned radv_ps5_waits_stats(uint64_t *out, unsigned slots);
+
+/* The switches as the driver reads them, one line ("draw waits: program; compute waits: on; ..."). */
+const char *radv_ps5_waits_settings(void);
+
+/* RADV_PS5_LATE_ALLOC's choice, for radv_shader.c and the line above: 0 as GFX10.3, 1 gfx10, 2 off */
+int radv_ps5_late_alloc_mode(void);
+
