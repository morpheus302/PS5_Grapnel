-/* RADV_PS5_SYNC_CS=1 and RADV_PS5_SYNC_PS=1, experiments: the halves of
+/* RADV_PS5_SYNC_CS=1 and RADV_PS5_SYNC_PS, experiments: the halves of
  * RADV_DEBUG=syncshaders, the wait for the compute engine after each dispatch
- * and the wait for the graphics one after each draw, each on its own. */
+ * and the wait for the graphics one after draws, each on its own.
+ *
+ * RADV_PS5_SYNC_PS chooses which draws wait (lot 57, radv_ps5_waits.h):
+ * - unset or 0: none;
+ * - 1 or each: every draw, as RADV_DEBUG=syncshaders (PS_PARTIAL_FLUSH and
+ *   PFP_SYNC_ME after it);
+ * - program: the same wait, but before the state of a draw whose shaders are
+ *   not the last draw's, before a command buffer's first draw and before a
+ *   dispatch, and only when a draw ran since the last wait for the pixel
+ *   shaders: the draws of a run of one program overlap on the GPU, the draws
+ *   of two programs never do (radv_ps5_waits_before_work);
+ * - vertex: VS_PARTIAL_FLUSH and PFP_SYNC_ME after every draw: the next draw
+ *   starts once the vertex and primitive (NGG) waves of this one are done,
+ *   its pixel waves may still run.
+ * Any other value: each, the safe one, said on standard error.
+ * RADV_DEBUG=syncshaders waits after every draw whatever these say. */
+enum radv_ps5_draw_sync {
+   RADV_PS5_DRAW_SYNC_NONE,
+   RADV_PS5_DRAW_SYNC_EACH,
+   RADV_PS5_DRAW_SYNC_PROGRAM,
+   RADV_PS5_DRAW_SYNC_VERTEX,
+};
+
+static const char *const radv_ps5_draw_sync_names[] = {"none", "each", "program", "vertex"};
+
+static enum radv_ps5_draw_sync
+radv_ps5_draw_sync_mode(void)
+{
+   static int mode = -1;
+   if (mode < 0) {
+      const char *const v = getenv("RADV_PS5_SYNC_PS");
+      int m;
+      if (!v || !*v || !strcmp(v, "0") || !strcmp(v, "none"))
+         m = RADV_PS5_DRAW_SYNC_NONE;
+      else if (!strcmp(v, "1") || !strcmp(v, "each"))
+         m = RADV_PS5_DRAW_SYNC_EACH;
+      else if (!strcmp(v, "program") || !strcmp(v, "2"))
+         m = RADV_PS5_DRAW_SYNC_PROGRAM;
+      else if (!strcmp(v, "vertex") || !strcmp(v, "3"))
+         m = RADV_PS5_DRAW_SYNC_VERTEX;
+      else {
+         fprintf(stderr, "radv/ps5: RADV_PS5_SYNC_PS=%s is not 0, 1, each, program or vertex: each\n", v);
+         m = RADV_PS5_DRAW_SYNC_EACH;
+      }
+      mode = m;
+   }
+   return (enum radv_ps5_draw_sync)mode;
+}
+
 static unsigned
 radv_ps5_sync_flags(void)
 {
    static int flags = -1;
    if (flags < 0) {
       const char *const cs = getenv("RADV_PS5_SYNC_CS");
-      const char *const ps = getenv("RADV_PS5_SYNC_PS");
       flags = (cs && atoi(cs) != 0 ? RADV_CMD_FLAG_CS_PARTIAL_FLUSH : 0) |
-              (ps && atoi(ps) != 0 ? RADV_CMD_FLAG_PS_PARTIAL_FLUSH : 0);
+              (radv_ps5_draw_sync_mode() == RADV_PS5_DRAW_SYNC_EACH ? RADV_CMD_FLAG_PS_PARTIAL_FLUSH : 0);
    }
    return (unsigned)flags;
 }
 
+/* RADV_PS5_NGGC=0 (lot 57): the shader-based NGG culling off at draw time (radv_get_nggc_settings). */
+static bool
+radv_ps5_nggc_off(void)
+{
+   static int off = -1;
+   if (off < 0) {
+      const char *const v = getenv("RADV_PS5_NGGC");
+      off = v && !strcmp(v, "0");
+   }
+   return off != 0;
+}
