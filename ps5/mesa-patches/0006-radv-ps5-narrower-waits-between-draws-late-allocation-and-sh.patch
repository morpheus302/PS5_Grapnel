+/* What radv_ps5_waits_stats reports: the command buffers' counts, added when they end. */
+static uint64_t radv_ps5_waits_totals[RADV_PS5_WAITS_STAT_COUNT];
+/* RADV_DEBUG=syncshaders or fullsync as the first draw saw it: -1 before it. */
+static int radv_ps5_debug_sync = -1;
+
+static_assert(ARRAY_SIZE(((struct radv_ps5_waits_state *)0)->counts) == RADV_PS5_WAITS_STAT_COUNT,
+              "radv_ps5_waits_state's counts are radv_ps5_waits_stats' slots");
+
+unsigned
+radv_ps5_waits_stats(uint64_t *out, unsigned slots)
+{
+   const unsigned n = MIN2(slots, (unsigned)RADV_PS5_WAITS_STAT_COUNT);
+   for (unsigned i = 0; i < n; i++)
+      out[i] = p_atomic_read(&radv_ps5_waits_totals[i]);
+   return n;
+}
+
+const char *
+radv_ps5_waits_settings(void)
+{
+   static char line[256];
+   static const char *const late_alloc[] = {"as GFX10.3", "as GFX10", "off"};
+   const int debug_sync = p_atomic_read(&radv_ps5_debug_sync);
+   snprintf(line, sizeof(line),
+            "draw waits (RADV_PS5_SYNC_PS): %s; compute waits (RADV_PS5_SYNC_CS): %s; RADV_DEBUG syncshaders: %s; "
+            "late alloc (RADV_PS5_LATE_ALLOC): %s; shader culling (RADV_PS5_NGGC): %s",
+            radv_ps5_draw_sync_names[radv_ps5_draw_sync_mode()],
+            (radv_ps5_sync_flags() & RADV_CMD_FLAG_CS_PARTIAL_FLUSH) ? "on" : "off",
+            debug_sync < 0 ? "not known yet" : debug_sync ? "on (every draw and dispatch waits)" : "off",
+            late_alloc[radv_ps5_late_alloc_mode()], radv_ps5_nggc_off() ? "off" : "as ever");
+   return line;
+}
+
+static void
+radv_ps5_waits_count(struct radv_cmd_buffer *cmd_buffer, enum radv_ps5_waits_stat stat)
+{
+   cmd_buffer->state.ps5_waits.counts[stat]++;
+}
+
+/* The command buffer's counts into the driver's (radv_EndCommandBuffer). */
+static void
+radv_ps5_waits_end(struct radv_cmd_buffer *cmd_buffer)
+{
+   struct radv_ps5_waits_state *s = &cmd_buffer->state.ps5_waits;
+   for (unsigned i = 0; i < RADV_PS5_WAITS_STAT_COUNT; i++) {
+      if (s->counts[i])
+         p_atomic_add(&radv_ps5_waits_totals[i], (uint64_t)s->counts[i]);
+      s->counts[i] = 0;
+   }
+}
+
+/* RADV_PS5_SYNC_PS=program: the wait for the pixel shaders (PS_PARTIAL_FLUSH and
+ * PFP_SYNC_ME, what syncshaders puts after each draw), before the state of a
+ * draw whose shaders are not the last draw's or that is the command buffer's
+ * first (draw true), or before a dispatch (draw false), when a draw ran since
+ * the last such wait or full idle. Emitted before the work's SET packets, as
+ * syncshaders' wait after the draw before comes before them. */
+static void
+radv_ps5_waits_before_work(struct radv_cmd_buffer *cmd_buffer, bool draw)
+{
+   if (radv_ps5_draw_sync_mode() != RADV_PS5_DRAW_SYNC_PROGRAM || cmd_buffer->qf != RADV_QUEUE_GENERAL)
+      return;
+
+   struct radv_ps5_waits_state *s = &cmd_buffer->state.ps5_waits;
+   enum radv_ps5_waits_stat stat;
+   if (draw) {
+      if (!s->drawn) {
+         stat = RADV_PS5_WAITS_FIRST;
+      } else if (!s->pending || (s->vgt == cmd_buffer->state.last_vgt_shader &&
+                                 s->ps == cmd_buffer->state.shaders[MESA_SHADER_FRAGMENT])) {
+         return;
+      } else {
+         stat = RADV_PS5_WAITS_PROGRAM;
+      }
+   } else {
+      if (!s->pending)
+         return;
+      stat = RADV_PS5_WAITS_DISPATCH;
+   }
+
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   struct radv_cmd_stream *cs = cmd_buffer->cs;
+   enum rgp_flush_bits sqtt_flush_bits = 0;
+
+   radeon_check_space(device->ws, cs->b, 16);
+   radv_cs_emit_cache_flush(device->ws, cs, pdev->info.gfx_level, &cmd_buffer->gfx9_fence_idx,
+                            cmd_buffer->gfx9_fence_va, RADV_CMD_FLAG_PS_PARTIAL_FLUSH, &sqtt_flush_bits,
+                            cmd_buffer->gfx9_eop_bug_va);
+   if (radv_cmdbuf_has_stage(cmd_buffer, MESA_SHADER_TASK) && cmd_buffer->gang.cs) {
+      radeon_check_space(device->ws, cmd_buffer->gang.cs->b, 16);
+      radv_cs_emit_cache_flush(device->ws, cmd_buffer->gang.cs, pdev->info.gfx_level, NULL, 0,
+                               RADV_CMD_FLAG_CS_PARTIAL_FLUSH, &sqtt_flush_bits, 0);
+   }
+   s->pending = false;
+   radv_ps5_waits_count(cmd_buffer, stat);
+}
