diff --git a/src/util/grapnel_win_posix.h b/src/util/grapnel_win_posix.h
new file mode 100644
index 00000000000..0494c009491
--- /dev/null
+++ b/src/util/grapnel_win_posix.h
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026 Grapnel contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * (Grapnel, MinGW) The few POSIX calls the shader cache makes, for Windows,
+ * so the cache a Windows PC fills is laid out as the console's driver reads
+ * it. Only the cache's files include this, and only on _WIN32.
+ */
+#ifndef GRAPNEL_WIN_POSIX_H
+#define GRAPNEL_WIN_POSIX_H
+
+#ifdef _WIN32
+
+#include <direct.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <io.h>
+#include <stdint.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <windows.h>
+
+/* Files are bytes; children inherit none. */
+#ifndef O_CLOEXEC
+#define O_CLOEXEC (O_NOINHERIT | O_BINARY)
+#endif
+
+/* mkdir has no mode on Windows. */
+#define mkdir(path, mode) _mkdir(path)
+
+static inline int
+fchmod(int fd, int mode)
+{
+   (void)fd;
+   (void)mode;
+   return 0;
+}
+
+/* flock: an advisory lock. Windows locks are mandatory over the bytes they
+ * cover, so the lock is taken on one byte far past any file's end, where no
+ * read or write of the cache ever goes. */
+#define LOCK_SH 1
+#define LOCK_EX 2
+#define LOCK_NB 4
+#define LOCK_UN 8
+#define GRAPNEL_LOCK_OFFSET_HI 0x7fffffffu
+
+static inline int
+flock(int fd, int op)
+{
+   HANDLE h = (HANDLE)_get_osfhandle(fd);
+   if (h == INVALID_HANDLE_VALUE) {
+      errno = EBADF;
+      return -1;
+   }
+   OVERLAPPED at = {0};
+   at.OffsetHigh = GRAPNEL_LOCK_OFFSET_HI;
+   if (op & LOCK_UN)
+      return UnlockFileEx(h, 0, 1, 0, &at) ? 0 : -1;
+   DWORD flags = (op & LOCK_EX) ? LOCKFILE_EXCLUSIVE_LOCK : 0;
+   if (op & LOCK_NB)
+      flags |= LOCKFILE_FAIL_IMMEDIATELY;
+   if (LockFileEx(h, flags, 0, 1, 0, &at))
+      return 0;
+   errno = GetLastError() == ERROR_LOCK_VIOLATION ? EWOULDBLOCK : EIO;
+   return -1;
+}
+
+/* mmap: only what the cache's index asks, a shared read-write view of a
+ * whole file from its start. */
+#define PROT_NONE 0
+#define PROT_READ 1
+#define PROT_WRITE 2
+#define MAP_SHARED 1
+#define MAP_PRIVATE 2
+#define MAP_FAILED ((void *)-1)
+
+static inline void *
+mmap(void *address, size_t bytes, int prot, int flags, int fd, int64_t offset)
+{
+   (void)address;
+   if (!(flags & MAP_SHARED) || fd < 0) {
+      errno = EINVAL;
+      return MAP_FAILED;
+   }
+   HANDLE file = (HANDLE)_get_osfhandle(fd);
+   const bool write = (prot & PROT_WRITE) != 0;
+   HANDLE mapping = CreateFileMappingW(file, NULL, write ? PAGE_READWRITE : PAGE_READONLY, 0, 0, NULL);
+   if (!mapping) {
+      errno = ENOMEM;
+      return MAP_FAILED;
+   }
+   void *view = MapViewOfFile(mapping, write ? FILE_MAP_WRITE : FILE_MAP_READ, (DWORD)((uint64_t)offset >> 32),
+                              (DWORD)offset, bytes);
+   CloseHandle(mapping); /* the view keeps the mapping */
+   if (!view) {
+      errno = ENOMEM;
+      return MAP_FAILED;
+   }
+   return view;
+}
+
+static inline int
+munmap(void *address, size_t bytes)
+{
+   (void)bytes;
+   return UnmapViewOfFile(address) ? 0 : -1;
+}
+
+#endif /* _WIN32 */
+#endif /* GRAPNEL_WIN_POSIX_H */
