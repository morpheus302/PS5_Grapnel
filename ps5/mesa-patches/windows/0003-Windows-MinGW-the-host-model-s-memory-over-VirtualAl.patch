+static void *
+radv_ps5_host_reserve(uint64_t address, uint64_t bytes)
+{
+   return VirtualAlloc((void *)(uintptr_t)address, bytes, MEM_RESERVE, PAGE_NOACCESS);
+}
+
+static bool
+radv_ps5_host_commit(void *at, uint64_t bytes)
+{
+   return VirtualAlloc(at, bytes, MEM_COMMIT, PAGE_READWRITE) == at;
+}
