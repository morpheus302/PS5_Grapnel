+{
+   VirtualFree(at, bytes, MEM_DECOMMIT);
+}
+
+static void *
+radv_ps5_host_map(uint64_t address, uint64_t bytes, uint64_t alignment)
+{
+   if (address)
+      return VirtualAlloc((void *)(uintptr_t)address, bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+   for (int attempt = 0; attempt < 8; attempt++) {
+      uint8_t *const raw = VirtualAlloc(NULL, bytes + alignment, MEM_RESERVE, PAGE_NOACCESS);
+      if (!raw)
+         return NULL;
+      uint8_t *const cpu = (uint8_t *)align64((uint64_t)(uintptr_t)raw, alignment);
+      VirtualFree(raw, 0, MEM_RELEASE);
+      void *const got = VirtualAlloc(cpu, bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+      if (got == cpu)
+         return got;
+      if (got)
+         VirtualFree(got, 0, MEM_RELEASE);
+   }
+   return NULL;
+}
+
+static void
+radv_ps5_host_unmap(void *at, uint64_t bytes)
+{
+   (void)bytes;
+   VirtualFree(at, 0, MEM_RELEASE);
+}
