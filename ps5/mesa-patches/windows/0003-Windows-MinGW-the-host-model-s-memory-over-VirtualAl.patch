 {
-   void *const window = mmap((void *)(uintptr_t)RADV_PS5_WINDOW_BASE, RADV_PS5_WINDOW_BYTES, PROT_NONE,
+   void *const at = mmap((void *)(uintptr_t)address, bytes, PROT_NONE,
+                         MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+   if (at != MAP_FAILED && at != (void *)(uintptr_t)address)
+      munmap(at, bytes);
+   return at == (void *)(uintptr_t)address ? at : NULL;
+}
+
+static bool
+radv_ps5_host_commit(void *at, uint64_t bytes)
+{
+   return mprotect(at, bytes, PROT_READ | PROT_WRITE) == 0;
+}
+
+static void
+radv_ps5_host_decommit(void *at, uint64_t bytes)
+{
+   /* Back to reserved, and zero when it is handed out again. */
+   mmap(at, bytes, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED, -1, 0);
+}
+
+static void *
+radv_ps5_host_map(uint64_t address, uint64_t bytes, uint64_t alignment)
+{
+   if (address) {
+      void *const cpu = mmap((void *)(uintptr_t)address, bytes, PROT_READ | PROT_WRITE,
                              MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
-   if (window != (void *)(uintptr_t)RADV_PS5_WINDOW_BASE) {
+      if (cpu == MAP_FAILED)
+         return NULL;
+      if (cpu != (void *)(uintptr_t)address) {
+         munmap(cpu, bytes);
+         return NULL;
+      }
+      return cpu;
+   }
+   /* Over-allocate so the start can be aligned, then trim. */
+   const uint64_t span = bytes + alignment;
+   uint8_t *const raw = mmap(NULL, span, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+   if (raw == MAP_FAILED)
+      return NULL;
+   uint8_t *const cpu = (uint8_t *)align64((uint64_t)(uintptr_t)raw, alignment);
+   if (cpu > raw)
+      munmap(raw, cpu - raw);
+   const uint8_t *const end = raw + span;
+   if (cpu + bytes < end)
+      munmap(cpu + bytes, end - (cpu + bytes));
+   return cpu;
+}
